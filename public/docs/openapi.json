  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Sanctum personal access token"
      }
    },
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "integer" }
      }
    },
    "responses": {
      "ValidationError": {
        "description": "422 — Validasi gagal",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ValidationErrorEnvelope" },
            "example": {
              "success": false,
              "message": "Validasi formulir penimbangan gagal.",
              "errors": {
                "items.0.weight_kg": ["Berat timbangan wajib diisi angka lebih besar dari 0."]
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "404 — Resource tidak ditemukan",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      }
    },
    "schemas": {
      "Envelope": {
        "type": "object",
        "description": "Format respon standar; isi `data` berbeda per endpoint (lihat deskripsi operasi).",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "example": "OK" },
          "data": { "type": "object", "additionalProperties": true },
          "meta": { "type": "object", "nullable": true, "properties": { "total": { "type": "integer" }, "page": { "type": "integer" }, "per_page": { "type": "integer" } } }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "message": { "type": "string" },
          "errors": { "type": "object", "nullable": true }
        }
      },
      "ValidationErrorEnvelope": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "message": { "type": "string" },
          "errors": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["identity", "password"],
        "properties": {
          "identity": { "type": "string", "description": "Username atau email", "example": "budi@mail.com" },
          "password": { "type": "string", "format": "password" },
          "device_name": { "type": "string", "example": "react_spa" }
        }
      },
      "RegisterMemberRequest": {
        "type": "object",
        "required": ["name", "email", "password", "member_type", "phone", "address"],
        "properties": {
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "username": { "type": "string", "description": "Opsional; default dari email" },
          "password": { "type": "string", "format": "password" },
          "member_type": { "type": "string", "enum": ["rumah", "pasar"], "description": "Kategori anggota" },
          "phone": { "type": "string" },
          "address": { "type": "string" },
          "nik": { "type": "string", "description": "Nomor Induk Kependudukan" }
        }
      },
      "UpdateProfileRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "phone": { "type": "string" },
          "address": { "type": "string" },
          "avatar": { "type": "string", "description": "File gambar avatar" }
        }
      },
      "ChangePasswordRequest": {
        "type": "object",
        "required": ["current_password", "new_password", "new_password_confirmation"],
        "properties": {
          "current_password": { "type": "string", "format": "password" },
          "new_password": { "type": "string", "format": "password" },
          "new_password_confirmation": { "type": "string", "format": "password" }
        }
      },
      "UserStoreRequest": {
        "type": "object",
        "required": ["name", "username", "email", "password", "role"],
        "properties": {
          "name": { "type": "string" },
          "username": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "format": "password" },
          "role": { "type": "string", "enum": ["pengurus", "petugas"] },
          "address": { "type": "string" }
        }
      },
      "UserUpdateRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "role": { "type": "string", "enum": ["pengurus", "petugas"] },
          "address": { "type": "string" },
          "is_active": { "type": "boolean" }
        }
      },
      "MemberUpdateRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "address": { "type": "string" },
          "phone": { "type": "string" },
          "member_category_id": { "type": "integer" }
        }
      },
      "TrashCategoryRequest": {
        "type": "object",
        "required": ["name", "type", "unit", "price_sell"],
        "properties": {
          "name": { "type": "string", "example": "PET Botol Bening" },
          "type": { "type": "string", "enum": ["organik", "anorganik", "campur"] },
          "unit": { "type": "string", "example": "kg" },
          "price_sell": { "type": "number", "example": 5000, "description": "Harga jual raw ke pengepul/marketplace" },
          "price_admin": { "type": "number", "example": 1000, "description": "Biaya admin per unit — input manual (guideline 20% dari harga jual)" },
          "price_member": { "type": "number", "example": 4000, "description": "Harga bersih untuk anggota = price_sell - price_admin (read-only, dihitung sistem)" },
          "is_active": { "type": "boolean" }
        }
      },
      "PickupStoreRequest": {
        "type": "object",
        "required": ["location_type"],
        "properties": {
          "member_id": { "type": "integer", "description": "Opsional untuk anggota (auto member miliknya); wajib untuk petugas/pengurus" },
          "scheduled_at": { "type": "string", "format": "date-time" },
          "location_type": { "type": "string", "enum": ["gudang", "jemput_rumah"] },
          "is_sorted": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      },
      "WeighItemsRequest": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["category_id"],
              "properties": {
                "category_id": { "type": "integer", "example": 1 },
                "weight_kg": { "type": "number", "example": 15.5, "description": "Untuk sampah per kg" },
                "unit_count": { "type": "integer", "example": 0, "description": "Untuk sampah per unit (mis. elektronik)" }
              }
            }
          }
        }
      },
      "ComplaintStoreRequest": {
        "type": "object",
        "required": ["pickup_id", "issue_type", "description"],
        "properties": {
          "pickup_id": { "type": "integer" },
          "issue_type": { "type": "string", "enum": ["berat_salah", "kategori_salah", "harga_salah"] },
          "description": { "type": "string" },
          "proof_image": { "type": "string", "description": "File foto bukti" }
        }
      },
      "SavingsPayRequest": {
        "type": "object",
        "required": ["member_id", "label", "jumlah", "metode"],
        "properties": {
          "user_id": { "type": "integer" },
          "member_id": { "type": "integer" },
          "label": { "type": "string", "enum": ["POKOK", "WAJIB", "TIPPING", "SUKARELA"] },
          "jumlah": { "type": "number", "example": 45000 },
          "metode": { "type": "string", "enum": ["tunai", "transfer"] },
          "catatan": { "type": "string" }
        }
      },
      "TransactionStoreRequest": {
        "type": "object",
        "required": ["category_id", "type", "amount"],
        "properties": {
          "category_id": { "type": "integer" },
          "type": { "type": "string", "enum": ["income", "expense"] },
          "amount": { "type": "number" },
          "description": { "type": "string" },
          "payment_method": { "type": "string", "enum": ["tunai", "transfer"] }
        }
      },
      "WithdrawRequest": {
        "type": "object",
        "required": ["amount", "method"],
        "properties": {
          "amount": { "type": "number", "example": 100000 },
          "method": { "type": "string", "enum": ["tunai", "transfer"] },
          "bank_name": { "type": "string" },
          "account_number": { "type": "string" },
          "account_holder": { "type": "string" }
        }
      },
      "LogisticsStoreRequest": {
        "type": "object",
        "required": ["jadwal_angkut", "kecamatan", "desa"],
        "properties": {
          "jadwal_angkut": { "type": "string", "format": "date-time" },
          "total_organik": { "type": "number", "description": "Kg sampah organik" },
          "total_anorganik": { "type": "number", "description": "Kg sampah anorganik" },
          "kecamatan": { "type": "string" },
          "desa": { "type": "string" },
          "dusun": { "type": "string" },
          "rw": { "type": "string" },
          "rt": { "type": "string" },
          "alamat": { "type": "string" }
        }
      }
    }
  }
}
