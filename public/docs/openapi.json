{
  "openapi": "3.1.0",
  "info": {
    "title": "Koperasi Jasa Mulyo Raharjo Lestari — API",
    "version": "1.0.0",
    "description": "RESTful API Sistem Informasi Koperasi & Bank Sampah.\n\n**Autentikasi:** Bearer Token Sanctum — `Authorization: Bearer <token>`\n\n**Header wajib:** `Accept: application/json`, `Content-Type: application/json`\n\n**Format respon standar:**\n```json\n{\n  \"success\": true,\n  \"message\": \"Deskripsi pesan\",\n  \"data\": { },\n  \"meta\": { \"total\": 100, \"page\": 1, \"per_page\": 15 }\n}\n```\n\nSemua endpoint selain yang ditandai Publik membutuhkan token Sanctum. Role: `ketua`, `pengurus`, `petugas`, `anggota`."
  },
  "servers": [
    { "url": "/api/v1" }
  ],
  "security": [{ "BearerAuth": [] }],
  "tags": [
    { "name": "Auth", "description": "Autentikasi & profil pengguna" },
    { "name": "Users", "description": "Manajemen pengguna internal (ketua/pengurus/petugas)" },
    { "name": "Keanggotaan", "description": "Master data kategori & anggota" },
    { "name": "Katalog Sampah", "description": "Katalog sampah & manajemen harga" },
    { "name": "Penjemputan", "description": "Operasional bank sampah: penjemputan & timbang" },
    { "name": "Pengaduan", "description": "Pengaduan & komplain nota timbang" },
    { "name": "Keuangan", "description": "Kategori keuangan, simpanan, transaksi kas" },
    { "name": "Dompet", "description": "Saldo anggota & penarikan tunai" },
    { "name": "SHU", "description": "Kalkulasi & pembagian SHU tahunan" },
    { "name": "Logistik", "description": "Wilayah & rekapitulasi pengangkutan" },
    { "name": "Laporan", "description": "Laporan eksekutif & analitik" }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login",
        "description": "Autentikasi dengan username/email + password, mengembalikan Sanctum token. Rate limit 10x/menit.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Token & data user",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" }, "example": { "success": true, "message": "Login berhasil", "data": { "token": "1|abcdef...", "user": { "id": 1, "name": "Budi", "role": "anggota" } } } } }
          },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Profil user yang login",
        "description": "Profil pengguna yang sedang login beserta role & identitas member.",
        "responses": {
          "200": {
            "description": "User & member profile",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } }
          }
        }
      }
    },
    "/auth/profile": {
      "put": {
        "tags": ["Auth"],
        "summary": "Update profil",
        "description": "Pembaruan informasi kontak profil mandiri.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateProfileRequest" } } }
        },
        "responses": {
          "200": {
            "description": "User ter-update",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } }
          },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/auth/change-password": {
      "put": {
        "tags": ["Auth"],
        "summary": "Ganti password",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChangePasswordRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Password berhasil diganti",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } }
          },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Logout",
        "description": "Mencabut (revoke) Sanctum personal access token saat ini.",
        "responses": {
          "200": {
            "description": "Token dicabut",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } }
          }
        }
      }
    },

    "/users": {
      "get": {
        "tags": ["Users"],
        "summary": "Daftar pengguna",
        "description": "Daftar pengguna sistem. Role: ketua, pengurus.",
        "parameters": [
          { "name": "role", "in": "query", "schema": { "type": "string" }, "description": "Filter role, mis. `petugas`" },
          { "name": "search", "in": "query", "schema": { "type": "string" }, "description": "Cari nama/username/email" },
          { "name": "page", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Daftar user (paginated)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } }
        }
      },
      "post": {
        "tags": ["Users"],
        "summary": "Buat akun internal",
        "description": "Buat akun pengurus/petugas. Role: ketua.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserStoreRequest" } } }
        },
        "responses": {
          "201": { "description": "User dibuat", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/users/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": {
        "tags": ["Users"],
        "summary": "Detail pengguna",
        "description": "Detail informasi akun pengguna. Role: ketua, pengurus.",
        "responses": {
          "200": { "description": "Detail user", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["Users"],
        "summary": "Update pengguna",
        "description": "Update data akun pengguna internal. Role: ketua.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserUpdateRequest" } } }
        },
        "responses": {
          "200": { "description": "User ter-update", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      },
      "delete": {
        "tags": ["Users"],
        "summary": "Hapus pengguna",
        "description": "Nonaktifkan / hapus akun pengguna sistem. Role: ketua.",
        "responses": {
          "200": { "description": "User dihapus", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } }
        }
      }
    },

    "/member-categories": {
      "get": {
        "tags": ["Keanggotaan"],
        "summary": "Daftar kategori anggota",
        "description": "Daftar kategori anggota (Biasa, Inti, Mitra). Role: ketua, pengurus, petugas.",
        "responses": {
          "200": { "description": "Daftar kategori", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } }
        }
      },
      "post": {
        "tags": ["Keanggotaan"],
        "summary": "Buat kategori anggota",
        "description": "Role: ketua, pengurus.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string", "example": "Anggota Inti" } } } } }
        },
        "responses": {
          "201": { "description": "Kategori dibuat", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/members/register": {
      "post": {
        "tags": ["Keanggotaan"],
        "summary": "Registrasi anggota oleh pengurus",
        "description": "Buat user (role `anggota`, + password) dan member sekaligus dalam satu transaksi. `member_code` autofill (`MBR-YYYYMM-XXXX`), `name` sama, `username` opsional (default dari email), member category `rumah`/`pasar`. Satu email/username hanya bisa diregistrasi sekali. Role: ketua, pengurus.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegisterMemberRequest" } } }
        },
        "responses": {
          "201": { "description": "User & member dibuat", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/members": {
      "get": {
        "tags": ["Keanggotaan"],
        "summary": "Daftar anggota",
        "description": "Daftar anggota. Role: ketua, pengurus, petugas.",
        "parameters": [
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["aktif", "nonaktif", "suspend", "pending"] } },
          { "name": "category_id", "in": "query", "schema": { "type": "integer" } },
          { "name": "search", "in": "query", "schema": { "type": "string" }, "description": "Cari nama / kode anggota" },
          { "name": "page", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Daftar anggota (paginated)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } }
        }
      }
    },
    "/members/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": {
        "tags": ["Keanggotaan"],
        "summary": "Detail anggota",
        "description": "Detail profil anggota, status simpanan pokok, dan rekap partisipasi bank sampah. Role: ketua, pengurus, petugas, anggota (hanya milik sendiri).",
        "responses": {
          "200": { "description": "Detail member", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["Keanggotaan"],
        "summary": "Update anggota",
        "description": "Update informasi profil anggota. Role: ketua, pengurus.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MemberUpdateRequest" } } }
        },
        "responses": {
          "200": { "description": "Member ter-update", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/members/{id}/status": {
      "patch": {
        "tags": ["Keanggotaan"],
        "summary": "Ubah status anggota",
        "description": "Role: ketua, pengurus.",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["status"], "properties": { "status": { "type": "string", "enum": ["aktif", "nonaktif", "suspend"] } }, "notes": { "type": "string", "description": "Alasan perubahan status" } } } }
        },
        "responses": {
          "200": { "description": "Status diubah", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },

    "/trash-categories": {
      "get": {
        "tags": ["Katalog Sampah"],
        "summary": "Katalog sampah",
        "description": "Publik (tanpa login). Seluruh katalog sampah.",
        "security": [],
        "parameters": [
          { "name": "type", "in": "query", "schema": { "type": "string", "enum": ["organik", "anorganik", "campur"] } },
          { "name": "is_active", "in": "query", "schema": { "type": "integer", "enum": [0, 1] } }
        ],
        "responses": {
          "200": { "description": "Daftar kategori sampah", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } }
        }
      },
      "post": {
        "tags": ["Katalog Sampah"],
        "summary": "Buat kategori sampah",
        "description": "Role: ketua, pengurus.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TrashCategoryRequest" } } }
        },
        "responses": {
          "201": { "description": "Kategori dibuat", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/trash-categories/board": {
      "get": {
        "tags": ["Katalog Sampah"],
        "summary": "Papan info harga terkini",
        "description": "Publik (tanpa login). Harga sampah hari ini, fluktuasi naik/turun, dan tarif antar gudang vs jemput.",
        "security": [],
        "responses": {
          "200": { "description": "Papan harga", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } }
        }
      }
    },
    "/trash-categories/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": {
        "tags": ["Katalog Sampah"],
        "summary": "Detail kategori sampah",
        "responses": {
          "200": { "description": "Detail kategori", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["Katalog Sampah"],
        "summary": "Update kategori sampah",
        "description": "Role: ketua, pengurus.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TrashCategoryRequest" } } }
        },
        "responses": {
          "200": { "description": "Kategori ter-update", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/trash-categories/{id}/price": {
      "patch": {
        "tags": ["Katalog Sampah"],
        "summary": "Quick update harga harian",
        "description": "Otomatis mencatat log audit perubahan harga. Role: ketua, pengurus.",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "price_sell": { "type": "number", "example": 5000, "description": "Harga jual raw" }, "price_admin": { "type": "number", "example": 1000, "description": "Biaya admin per unit — input manual" }, "price_sorted": { "type": "number", "example": 5000 }, "price_unsorted": { "type": "number", "example": 2200 }, "notes": { "type": "string", "example": "Update WA paguyuban" } } } } }
        },
        "responses": {
          "200": { "description": "Harga ter-update", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/trash-categories/{id}/price-history": {
      "get": {
        "tags": ["Katalog Sampah"],
        "summary": "Riwayat harga",
        "description": "Riwayat audit fluktuasi harga (siapa mengubah, nominal lama, nominal baru, tanggal). Role: ketua, pengurus.",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": {
          "200": { "description": "Riwayat harga", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } }
        }
      }
    },

    "/pickups": {
      "get": {
        "tags": ["Penjemputan"],
        "summary": "Daftar penjemputan",
        "description": "Daftar order/jadwal penjemputan sampah. Role: ketua, pengurus, petugas.",
        "parameters": [
          { "name": "status", "in": "query", "schema": { "type": "string" }, "description": "mis. `menunggu`, `selesai`" },
          { "name": "source", "in": "query", "schema": { "type": "string", "enum": ["manual", "rutin", "auto"] }, "description": "Filter sumber tiket" },
          { "name": "date", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "page", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Daftar pickup (paginated)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } }
        }
      },
      "post": {
        "tags": ["Penjemputan"],
        "summary": "Buat tiket setor/jemput sampah (pesan ala gojek)",
        "description": "Permintaan on-demand per anggota — seperti pesanan gojek. Anggota tanpa `member_id` otomatis pakai member miliknya. Role: ketua, pengurus, petugas, anggota.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PickupStoreRequest" } } }
        },
        "responses": {
          "201": { "description": "Pickup dibuat, mengembalikan `pickup_id`", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/pickups/generate-routine": {
      "post": {
        "tags": ["Penjemputan"],
        "summary": "Trigger pickup rutin bulanan",
        "description": "Buat tiket penjemputan rutin (`source=rutin`) untuk semua anggota aktif. Jalan otomatis via scheduler tiap awal bulan; endpoint ini untuk trigger manual. Role: ketua, pengurus.",
        "requestBody": {
          "required": false,
          "content": { "application/json": { "schema": { "type": "object", "properties": {} } } }
        },
        "responses": {
          "200": { "description": "Tiket rutin dibuat", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } }
        }
      }
    },
    "/pickups/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": {
        "tags": ["Penjemputan"],
        "summary": "Detail penjemputan",
        "description": "Detail transaksi penjemputan & rincian item timbangan. Role: ketua, pengurus, petugas, anggota (milik sendiri).",
        "responses": {
          "200": { "description": "Detail pickup", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/pickups/{id}/photo": {
      "post": {
        "tags": ["Penjemputan"],
        "summary": "Upload foto dokumentasi pengambilan",
        "description": "Petugas mengunggah foto dokumentasi saat pengambilan sampah. Multipart form-data, field `photo` (jpg/png, maks 5MB). Role: ketua, pengurus, petugas.",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["photo"],
                "properties": {
                  "photo": { "type": "string", "format": "binary", "description": "File foto (jpg/jpeg/png)" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Mengembalikan `photo_url`", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/pickups/{id}/weigh-items": {
      "post": {
        "tags": ["Penjemputan"],
        "summary": "Input timbangan & kalkulasi real-time",
        "description": "Business logic otomatis: (1) hitung nilai bruto dari tarif hari ini, (2) potongan 20% biaya koperasi, (3) saldo bersih dikreditkan ke saldo anggota, (4) status pickup jadi `selesai`. Role: ketua, pengurus, petugas.",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WeighItemsRequest" } } }
        },
        "responses": {
          "200": { "description": "Mengembalikan `pickup`, `items`, `net_earned`, `receipt_number`", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/pickups/{id}/receipt": {
      "get": {
        "tags": ["Penjemputan"],
        "summary": "Nota digital timbang",
        "description": "Detail nota timbang: QR Code URL, nominal kotor, potongan 20%, saldo bersih masuk. Role: ketua, pengurus, petugas, anggota (milik sendiri).",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": {
          "200": { "description": "Data nota", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/pickups/{id}/cancel": {
      "patch": {
        "tags": ["Penjemputan"],
        "summary": "Batalkan transaksi timbang",
        "description": "Batalkan transaksi jika terjadi kesalahan fatal (rollback saldo otomatis). Role: ketua, pengurus.",
        "parameters": [{ "$ref": "#/components/parameters/Id" }],
        "responses": {
          "200": { "description": "Pickup dibatalkan", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } }
        }
      }
    },

    "/complaints": {
      "get": {
        "tags": ["Pengaduan"],
        "summary": "Daftar komplain",
        "description": "Daftar komplain (anggota hanya melihat miliknya). Role: ketua, pengurus, petugas, anggota.",
        "parameters": [
          { "name": "status", "in": "query", "schema": { "type": "string" }, "description": "mis. `diajukan`, `proses`, `selesai`" },
          { "name": "page", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Daftar komplain (paginated)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } }
        }
      },
      "post": {
        "tags": ["Pengaduan"],
        "summary": "Ajukan komplain nota",
        "description": "Role: ketua, pengurus, petugas, anggota.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ComplaintStoreRequest" } } }
        },
        "responses": {
          "201": { "description": "Komplain dibuat", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/complaints/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "get": {
